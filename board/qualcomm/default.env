stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
preboot=scsi scan; usb start
fastboot=fastboot -l $fastboot_addr_r usb 0
do_boot=bootflow scan -lb
serial_gadget=setenv stdin serial,button-kbd,usbacm; setenv stdout serial,vidconsole,usbacm; setenv stderr serial,vidconsole,usbacm; setenv bootretry -1; echo Enabled U-Boot console gadget :3
bootmenu_0=Boot first available device=run do_boot
bootmenu_1=Enable USB mass storage=ums 0 mmc 0
bootmenu_2=Enable fastboot mode=run fastboot
bootmenu_3=Enable serial console gadget=run serial_gadget
bootmenu_4=Reset device=reset
menucmd=bootmenu -1
bootcmd=run do_boot
